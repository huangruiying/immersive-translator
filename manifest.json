{
  "manifest_version": 3,
  "name": "网页双语翻译助手",
  "version": "1.0.0",
  "description": "对接任意 OpenAI 兼容大模型端点 (v1/chat/completions) 的页面内联双语翻译插件，Chrome / Edge 通用。",
  "permissions": ["storage", "contextMenus", "commands", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "网页双语翻译助手"
  },
  "options_page": "options.html",
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "翻译当前页面"
    },
    "restore-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "还原当前页面"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
