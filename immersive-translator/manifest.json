{
  "manifest_version": 3,
  "name": "沉浸式翻译 (大模型自定义端点版)",
  "version": "1.0.0",
  "description": "对接任意 OpenAI 兼容大模型端点 (v1/chat/completions) 的页面内联双语翻译插件，Chrome / Edge 通用。",
  "permissions": ["storage", "contextMenus", "commands", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "沉浸式翻译"
  },
  "options_page": "options.html",
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "翻译当前页面"
    },
    "restore-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "还原当前页面"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
